# Environment reference. The Rust binary does not parse this file itself.
# Export values in the launching shell or set them in the MCP client.
# Never commit real credentials.

# Headless MCP Direct mode. Wins if PATH and SERVER are both set.
# MONGRELDB_VIEWER_PATH=/absolute/path/to/mongreldb-root

# Headless MCP Server mode.
# MONGRELDB_VIEWER_SERVER=http://127.0.0.1:8453
# MONGRELDB_VIEWER_TOKEN=
# MONGRELDB_VIEWER_USER=
# MONGRELDB_VIEWER_PASSWORD=

# Development-only Direct auto-open for the React UI.
# VITE_AUTO_OPEN_DB=/absolute/path/to/mongreldb-root

# Tauri/Vite remote development host. HMR uses port 1421.
# TAURI_DEV_HOST=192.0.2.10

# Linux GUI defaults. Viewer sets each to 1 only when it is absent.
# WEBKIT_DISABLE_DMABUF_RENDERER=1
# WEBKIT_DISABLE_COMPOSITING_MODE=1
